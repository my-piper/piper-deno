{
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/encoding": "jsr:@std/encoding@^1.0.10",
    "imagescript": "jsr:@matmen/imagescript@^1.3.1",
    "zod": "npm:zod@^3.22.4"
  },
  "tasks": {
    "install": "deno cache --frozen src/server.ts src/execution/worker/worker.ts src/execution/process/child.ts src/**/*.test.ts tests/**/*.test.ts",
    "start": "deno run --allow-net --allow-read --allow-env --allow-run src/server.ts",
    "test": "deno test --allow-net --allow-read --allow-env --allow-run --allow-write src/",
    "test:unit": "deno test --allow-net --allow-read --allow-env --allow-run --allow-write src/execution/worker/executor.test.ts src/execution/buffer-to-data-uri.test.ts",
    "test:concurrent": "deno test --allow-net --allow-read --allow-env --allow-run --allow-write src/execution/worker/concurrent.test.ts",
    "test:e2e": "deno test --allow-net --allow-read --allow-env --allow-run --allow-write tests/e2e/",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "fmt:watch": "deno fmt --watch",
    "lint": "deno lint",
    "lint:fix": "deno lint --fix",
    "lint:watch": "deno lint --watch",
    "check": "deno fmt --check && deno lint && deno task check:imports && deno check src/ tests/ scripts/",
    "check:imports": "deno run --allow-read scripts/check-no-remote-imports.ts",
    "check:types": "deno check src/ tests/ scripts/"
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 80,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "proseWrap": "preserve",
    "include": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.js",
      "**/*.jsx",
      "**/*.json"
    ],
    "exclude": [
      "node_modules/",
      "deno.lock"
    ]
  },
  "lint": {
    "include": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.js",
      "**/*.jsx"
    ],
    "exclude": [
      "node_modules/",
      "deno.lock",
      "**/*.test.ts"
    ],
    "rules": {
      "tags": [
        "recommended"
      ],
      "include": [
        "ban-untagged-todo",
        "camelcase",
        "eqeqeq",
        "explicit-function-return-type",
        "no-await-in-loop",
        "no-const-assign",
        "no-eval",
        "no-implicit-declare-namespace-export",
        "no-non-null-assertion",
        "no-throw-literal",
        "no-var",
        "prefer-const"
      ],
      "exclude": [
        "no-explicit-any",
        "no-process-global"
      ]
    }
  }
}
